# Required
DISCORD_TOKEN=your_discord_bot_token_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional backup web search
TAVILY_API_KEY=

# Discord bot settings
# Prefer channel IDs in production. Leave both empty to allow all channels.
ALLOWED_CHANNEL_IDS=
ALLOWED_CHANNELS=general,help,bot-commands
COMMAND_PREFIX=!ask
BOT_STATUS_MESSAGE=AI help | !ask

# AI settings
OPENROUTER_MODEL=deepseek/deepseek-v3-base:free
MAX_TOKENS=1024
MAX_HISTORY=10
MAX_KNOWLEDGE_CHARS=4000
RATE_LIMIT_SECONDS=3

# Optional system prompt override
SYSTEM_PROMPT=
